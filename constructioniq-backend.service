[Unit]
Description=ConstructionIQ Backend API Service
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ki8_exe
Environment="PATH=/home/ubuntu/ki8_exe/venv/bin"
EnvironmentFile=/home/ubuntu/ki8_exe/.env.production
ExecStart=/home/ubuntu/ki8_exe/venv/bin/python -m backend_ai.main
Restart=always
RestartSec=10

# Logging
StandardOutput=append:/var/log/constructioniq-backend.log
StandardError=append:/var/log/constructioniq-backend-error.log

# Security
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
